# Copy to .env.local and fill in. Never commit real keys.

# Content: show drafts (Phase 3 to 5). Fixed at build time.
CONTENT_PREVIEW=0

# Mail (lib/mail). Without these, forms say that delivery is not set up.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Softwarekenner <redaktion@example.de>"
MAIL_FROM=
# Editorial inbox for requests. Falls back to CONTACT_EMAIL in site.config.ts once set.
MAIL_TO=
# Optional: Resend segment for newsletter contacts
RESEND_SEGMENT_ID=

# Double opt in tokens (lib/forms/tokens.ts): at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORM_TOKEN_SECRET=

# Local tests only: writes every mail as JSON into this folder instead of sending it.
# Never set in production.
MAIL_OUTBOX_DIR=
