{
  "name": "gem1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm content:validate && node scripts/build-search-index.ts --dev && next dev",
    "build": "pnpm content:validate && pnpm search:index && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:copy": "node scripts/lint-copy.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "node scripts/validate-content.ts",
    "search:index": "node scripts/build-search-index.ts",
    "check:css": "node scripts/check-build-css.ts",
    "fonts:build": "node scripts/build-fonts.ts"
  },
  "dependencies": {
    "@content-collections/mdx": "0.2.2",
    "@hookform/resolvers": "5.9.2",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "fuse.js": "7.5.0",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "nuqs": "2.10.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@content-collections/core": "0.15.3",
    "@content-collections/next": "0.2.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.9.0"
}
